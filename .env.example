# Copy this to .env for local development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MONITOR_USER=monitor
MONITOR_USER_PASSWORD=secret

# Dashboard admin login (ADMIN_PASSWORD is required — server exits if unset)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# How often to poll replication status (milliseconds)
POLL_INTERVAL_MS=10000

# Dashboard server port
PORT=3000
